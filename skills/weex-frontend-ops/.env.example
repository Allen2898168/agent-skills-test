# WEEX frontend runtime config. Copy to `.env.local` in this skill directory.
# Do not commit real passwords, tokens, cookies, TOTP secrets, or private user data.

WEEX_FRONTEND_ENV=stg
WEEX_FRONTEND_URL=https://stg-www.weex.tech/zh-CN/login
WEEX_FRONTEND_ACCOUNT_URL=https://stg-www.weex.tech/zh-CN/account

# Optional local loginTool checkout override. Leave empty to use the bundled skill copy.
WEEX_FRONTEND_LOGIN_TOOL_DIR=

# Optional API bases for login-dependent frontend API scripts.
WEEX_FRONTEND_LOGIN_GATEWAY_BASE_URL=https://stg-gateway.weex.tech
WEEX_FRONTEND_ASSET_GATEWAY_BASE_URL=https://stg-gateway2.weex.tech

# Optional contract Open API settings for API-driven contract trading tasks.
# Keep these values only in this skill's .env.local. Never commit real values.
WEEX_FRONTEND_CONTRACT_API_BASE_URL=https://stg-api-contract.weex.tech
WEEX_FRONTEND_CONTRACT_API_KEY=<合约APIKey>
WEEX_FRONTEND_CONTRACT_API_SECRET=<合约Secret>
WEEX_FRONTEND_CONTRACT_API_PASSPHRASE=<合约Passphrase>

# Required common password used when an account has no dedicated password.
WEEX_FRONTEND_COMMON_PASSWORD=<运行时由用户填写>

# Required: one default account alias and its username.
WEEX_FRONTEND_DEFAULT_ACCOUNT=DEFAULT
WEEX_FRONTEND_ACCOUNTS=DEFAULT
WEEX_FRONTEND_ACCOUNT_DEFAULT_USERNAME=<默认账号>

# Optional: account-specific password. If empty, common password is used.
WEEX_FRONTEND_ACCOUNT_DEFAULT_PASSWORD=

# Optional: account description.
WEEX_FRONTEND_ACCOUNT_DEFAULT_DESCRIPTION=默认前端测试账号

# Optional one-off runtime account override.
# WEEX_FRONTEND_USERNAME=<一次性账号>
# WEEX_FRONTEND_PASSWORD=<一次性密码>

# Optional browser settings.
# WEEX_FRONTEND_BROWSER_VISIBLE=true
# WEEX_FRONTEND_BROWSER_CHANNEL=chrome
# WEEX_FRONTEND_CHROME_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
